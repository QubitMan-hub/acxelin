[Unit]
Description=Acxelin VPN enrollment service (EST over post-quantum TLS), where invitations enroll
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/acxelin-vpn/ca/ca.crt

[Service]
User=acxelin
EnvironmentFile=-/etc/acxelin-vpn/ca.env
ExecStart=/opt/acxelin-vpn/bin/acxelin-vpn ca serve --dir /var/lib/acxelin-vpn/ca --cert /etc/acxelin-vpn/enroll/chain.pem --key /etc/acxelin-vpn/enroll/key.pem
Restart=always
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/acxelin-vpn/ca
# Sandboxing: systemd-analyze security scores this unit; it keeps only what the service needs.
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
