[Unit]
Description=Acxelin VPN WireGuard gateway: each person's PSK agreed over ML-DSA mutual TLS, rotated, cut on revocation
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/acxelin-vpn/gateway.toml

[Service]
ExecStart=/opt/acxelin-vpn/bin/acxelin-vpn gateway --config /etc/acxelin-vpn/gateway.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
StateDirectory=acxelin-vpn
NoNewPrivileges=yes
# Sandboxing: systemd-analyze security scores this unit; it keeps only what the service needs.
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
