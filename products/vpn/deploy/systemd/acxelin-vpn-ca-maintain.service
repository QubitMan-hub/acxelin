[Unit]
Description=Acxelin VPN CA maintenance: renew expiring certificates, re-sign the revocation list
ConditionPathExists=/var/lib/acxelin-vpn/ca/ca.crt

[Service]
Type=oneshot
User=acxelin
EnvironmentFile=-/etc/acxelin-vpn/ca.env
ExecStart=/opt/acxelin-vpn/bin/acxelin-vpn ca maintain --dir /var/lib/acxelin-vpn/ca
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/acxelin-vpn/ca
# Sandboxing: systemd-analyze security scores this unit; it keeps only what the service needs.
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
