[Unit]
Description=Acxelin VPN site-to-site IPsec: strongSwan with ML-KEM, its PSK and PPK agreed over ML-DSA mutual TLS
After=network-online.target strongswan-pqc.service
Wants=network-online.target
Requires=strongswan-pqc.service
ConditionPathExists=/etc/acxelin-vpn/site.toml

[Service]
ExecStart=/opt/acxelin-vpn/bin/acxelin-vpn up --config /etc/acxelin-vpn/site.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
NoNewPrivileges=yes
# Sandboxing: systemd-analyze security scores this unit; it keeps only what the service needs.
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
